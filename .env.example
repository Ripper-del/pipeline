# ==============================================================================
# Pipeline Configuration - Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Client Credentials (Shared / API Configuration)
# ------------------------------------------------------------------------------
# Get these from https://my.telegram.org/
API_ID=1234567
API_HASH=abcdef0123456789abcdef0123456789

# ------------------------------------------------------------------------------
# 2. Uniqreo Bot Configuration - this is now the ONE Telegram bot process for
# the whole pipeline (uniqueization, /upload, lead funnel, ops-group control
# panel). It authenticates with REDIRECT_BOT_TOKEN, defined in section 3 below -
# there is no separate bot token for uniqreo anymore (Telegram doesn't allow
# two processes to poll the same bot token at once, so this had to be one bot).
# ------------------------------------------------------------------------------

# Chat thread configuration for message forwarding/interception
# Use 0 for "Listening/Logger" mode (logs chat and thread IDs to console on message caught)
SOURCE_THREAD_ID=0
TARGET_THREAD_ID=0

# Comma-separated Telegram user IDs allowed to run /upload (drives a real AdsPower
# browser + posts live video to TikTok). Empty means nobody can use /upload.
ADMIN_TELEGRAM_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# 3. Shared Telegram Bot Token + Lead Funnel Configuration
# ------------------------------------------------------------------------------
# The single Telegram Bot Token used by the merged uniqreo bot process, and as
# the sender identity for all log/lead notifications (automator.py, uploader.py,
# s2s-postback-server).
REDIRECT_BOT_TOKEN=9876543210:ZYXwvuTsrQPonMlKjIhGfedCBA

# Base smartlink URL (will be appended with user's ID)
# Example: https://example.com/click?sub1=
SMARTLINK_URL=https://google.com/

# ------------------------------------------------------------------------------
# 4. Ubtbot S2S FastAPI Server & Lead Notification Configuration
# ------------------------------------------------------------------------------
# Shared secret the partner network (e.g. iMonetizeIt) must send back as
# ?secret=... on every postback. Without it /postback rejects all requests -
# generate a random value and add it to the postback URL in the partner's panel.
S2S_POSTBACK_SECRET=change-me-to-a-random-value

# Chat ID to send logs/conversions to (falls back to LEAD_CHAT_ID if LOG_CHAT_ID is empty)
LEAD_CHAT_ID=-1001234567890
LOG_CHAT_ID=-1001234567890

# Chat Thread IDs for different logging channels.
# WARMUP_THREAD_ID and SPY_THREAD_ID point at the same thread here so both
# modes' logs and control buttons live in one chat/topic - set them to
# different values if you'd rather split warmup and spy into separate topics.
LEAD_THREAD_ID=42
WARMUP_THREAD_ID=101
SPY_THREAD_ID=101
UPLOAD_THREAD_ID=103

# UTC hour (0-23) at which the daily "leads today" summary is posted to LEAD_CHAT_ID
DAILY_REPORT_HOUR_UTC=21

# URL telegram-redirect-bot uses to call s2s-postback-server's /stats endpoint
# for the "📊 Статистика за сутки" control-panel button. In Docker Compose this
# is the service name; for a non-Docker local run use http://localhost:8000.
S2S_STATS_URL=http://s2s_server:8000

# Default GEO used when a warmup/spy run is launched from the ops-group control
# panel buttons (no per-run prompt - see telegram-redirect-bot/bot.py)
DEFAULT_GEO=US

# ------------------------------------------------------------------------------
# 5. Ubtbot WhatsApp Redirect/Follow-up Bot Configuration
# ------------------------------------------------------------------------------
# Green API instance credentials (get from https://green-api.com)
GREEN_API_ID_INSTANCE=1101000001
GREEN_API_TOKEN_INSTANCE=d75b3a66374942c5b3c019c698abc2067e151558acbd412345
GREEN_API_URL=https://api.green-api.com

# ------------------------------------------------------------------------------
# 6. TikTok Automator & Scraper Configuration
# ------------------------------------------------------------------------------
# AdsPower Local API configuration (by default running on port 50325)
ADSPOWER_API_URL=http://localhost:50325
# Default AdsPower browser profile ID to automate
ADSPOWER_PROFILE_ID=j1a2b3c4
# Comma-separated profile IDs to automate one after another in rotation mode
# (takes priority over ADSPOWER_PROFILE_ID if set). See automator.py --profile-ids.
ADSPOWER_PROFILE_IDS=


